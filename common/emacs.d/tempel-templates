;; |-------------------------+------------+----------------------------|


(<em
 "%+EMACS: HQ Prompt Skel+%" n
 "%+ROLE → TASK → CONTEXT → CONSTRAINTS → OUTPUT → EXAMPLE+%" n
 "## ROLE ##" n
(p (completing-read "Role: "
                        '("<wm-niri-learn"
                          "<wm-niri-prod"
                          "<wm-niri-dev"
                          "<wm-niri-quick"
                          "<wm-niri-review")) role) n
n "## TASK ##" n
(p "Describe the specific task...") n
n "## CONTEXT ##" n
(p "Emacs version, relevant packages, configuration snippet") n
n "## CONSTRAINTS ##" n
(p "What to avoid? External deps, frameworks.. '<rule-nofluff '<rule-fact '<rule-wm-niri-") n
n "## OUTPUT ##" n
(p "Format: explanation, elisp snippet, config block, keybinding") n
n "## EXAMPLE ##" n
(p "Optional example here, or Delete") n q)


(<em-dev
"%+Developer Emacs/Lisp Expert+%" n
"## ROLE ##" n
"You are an expert Emacs Lisp developer and seasoned Emacs user with "
"deep knowledge of: modern Emacs conventions (lexical binding, "
"package.el, use-package), built-in libraries (pcase, seq, map, "
"cl-lib), completion frameworks (vertico, corfu, orderless), "
"tree-sitter integration, native compilation, and the Emacs "
"client/server model. You understand the ecosystem's best practices, "
"common pitfalls, and the philosophy of self-documenting, extensible "
"editing." n)

(<em-seq_fName
 "%+EMACS: Sequential Filename+%" n
 "Auto calculate/generate a sequential filename in the current directory (a_01.zip, a_02.zip)." n
 "Do not prompt the user for a name; remind them that this will be hardcoded." n)

(<em-bg_exec
 "%+EMACS: Background Execution+%" n
 "Execute the action on the files silently in the background using a system/external tool." n)

(<em-ui_updt
 "%+EMACS: UI Update (revert-buffer)+%" n
 "Automatically refresh the dired/dirvish buffer (revert-buffer) immediately after the action so the new content is visible to the user right away." n)

(<em-mbuff_compl
 "%+EMACS: Minibuffer Dropdown Prompt+%" n
 "Use completing-read to open a clean minibuffer prompt asking the user to select the action." n)

(<em-ext
 "%+EMACS: Absolute Path of a File+%" n
 "Pass the absolute path of the newly created file to the chosen external CLI
 script or terminal emulator for final delivery." n)


