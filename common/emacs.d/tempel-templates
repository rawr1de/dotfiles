;; =======================================================
;; ORG-MODE -- NATIVE
;; =======================================================
;;
;; |------------------------+---------|
;; | OVERVIEW               | TRIGGER |
;; |------------------------+---------|
;; | src :language          | <s      |
;; | example                | <e      |
;; | quote                  | <q      |
;; | center                 | <c      |
;; | Comment                | <C      |
;; | verse                  | <v      |
;; | latex                  | <l      |
;; | html                   | <h      |
;; | src :language :results | <src    |
;; |------------------------+---------|


(<s
 n> "#+begin_src " (p "language: ") n>
 n> "#+end_src" n>)

(<e
 n> "#+begin_example" n>
 n> "#+end_example" n>)

(<q
 n> "#+begin_quote" n>
 n> "#+end_quote" n>)

(<c
 n> "#+begin_center" n>
 n> "#+end_center" n>)

(<C
 n> "#+begin_comment" n>
 n> "#+end_comment" n>)

(<v
 n> "#+begin_verse" n>
 n> "#+end_verse" n>)

(<l
 n> "#+begin_export latex" n>
 n> "#+end_export" n>)

(<h
 n> "#+begin_export html" n>
 n> "#+end_export" n>)

(<src
 n> "#+begin_src " (p "language: ") " :results " (p "results: ") n>
 n> (p "body") n>
 n> "#+end_src" n>)


