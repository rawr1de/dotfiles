[manager]
ratio          = [1, 3, 4]
sort_by        = "natural"
sort_sensitive = false
sort_reverse   = false
sort_dir_first = true
show_hidden    = false
show_symlink   = true
scrolloff      = 8

[preview]
image_filter = "triangle"
image_quality = 75
sixel_fraction = 15
ueberzug_scale = 1

[[opener.edit_sh]]
run = 'emacsclient -c -a -- "$@"'
desc = "MY Emacs (GUI)"
orphan = true

[[opener.edit_sh]]
run = 'emacsclient -nw "$@"'
desc = "MY Emacs (Terminal)"
block = true

[[opener.edit_sh]]
run = 'nano "$@"'
desc = "Nano"
block = true

[[opener.edit_sh]]
run = 'kate "$@"'
desc = "Kate"
orphan = true

[[opener.edit]]
run = 'emacsclient -c -a -- "$@"'
desc = "KK Emacs (GUI)"
orphan = true

[[opener.edit]]
run = 'emacsclient -nw "$@"'
desc = "KK Emacs (terminal)"
block = true

[[opener.open_md]]
run = 'kitty --class md_floating -e mdfried "$@" &'
desc = "mdfried"
orphan = true

[[opener.open_pdf]]
run = 'zathura "$@"'
desc = "Zathura"
orphan = true

[[opener.open_video]]
run = 'mpv "$@"'
desc = "mpv"
orphan = true

[[opener.open_audio]]
run = 'mpv "$@"'
desc = "mpv"
orphan = true

[[opener.open_image]]
run = 'sxiv -af "$@"'
desc = "sxiv"
orphan = true

[[opener.extract]]
run = 'atool --extract --each -- "$@"'
desc = "Extract (atool)"

[[opener.list_archive]]
run = 'atool --list --each -- "$@" | "$PAGER"'
desc = "List (atool)"
block = true

[[open.prepend_rules]]
url = "*.sh"
use = "edit_sh"

[[open.prepend_rules]]
name = "*.md"
use = ["open_md", "edit"]

[[open.prepend_rules]]
name = "*.py"
use = "edit"

[[open.prepend_rules]]
name = "*.org"
use = "edit"

[[open.prepend_rules]]
mime = "application/pdf"
use = "open_pdf"

[[open.prepend_rules]]
mime = "video/*"
use = "open_video"

[[open.prepend_rules]]
mime = "audio/*"
use = "open_audio"

[[open.prepend_rules]]
mime = "image/*"
use = "open_image"

[[open.prepend_rules]]
mime = "application/zip"
use = ["extract", "list_archive"]

[[open.prepend_rules]]
mime = "application/x-tar"
use = ["extract", "list_archive"]

[[open.prepend_rules]]
mime = "application/x-rar"
use = ["extract", "list_archive"]

[[open.prepend_rules]]
mime = "application/x-7z-compressed"
use = ["extract", "list_archive"]

[tasks]
micro_workers    = 10
macro_workers    = 25
bizarre_retry    = 5
image_alloc      = 536870912
image_bound      = [0, 0]
suppress_preload = false

[log]
enabled = false
