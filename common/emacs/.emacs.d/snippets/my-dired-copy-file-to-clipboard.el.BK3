(require 'url-util) ;; Ensure URL encoding functions are loaded

(defun my-dired-copy-file-to-clipboard ()
  "Copy marked file(s) to Wayland clipboard as actual files (GNOME-compatible format).
Works for Firefox, Telegram, Nautilus, etc. on Wayland."
  (interactive)
  (let* ((files (dired-get-marked-files))
         ;; Build the list of properly encoded file:// URIs
         (uri-list (mapconcat (lambda (f)
                                (url-encode-url (concat "file://" (expand-file-name f))))
                              files "\n")))

    (with-temp-buffer
      ;; GNOME format: "copy" + list of URIs + trailing newline
      (insert "copy\n" uri-list "\n")

      (call-process-region (point-min) (point-max)
                           "wl-copy" nil nil nil
                           "-t" "x-special/gnome-copied-files"))

    (message "Copied %d file(s) to Wayland clipboard (GNOME format)." (length files))))

(provide 'my-dired-copy-file-to-clipboard)
