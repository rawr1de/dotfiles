;; Enable Vertico
(use-package vertico
  :ensure t
  :custom
  (vertico-scroll-margin 0) ;; How many lines to keep visible at the top/bottom
  (vertico-count 20)        ;; Show up to 20 candidates at once
  (vertico-resize t)        ;; Grow and shrink the minibuffer
  (vertico-cycle t)         ;; Enable cycling back to the top
  :init
  (vertico-mode 1))         ;; Force it on globally

;; Optional but highly recommended: Persist history over Emacs restarts.
