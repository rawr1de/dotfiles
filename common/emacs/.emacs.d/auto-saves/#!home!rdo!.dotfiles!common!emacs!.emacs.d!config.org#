  (defhydra hydra-dired-jump (:color blue :hint nil)
    ;; This string is the ONLY thing that will show up.
    "
    ^Jumps^               ^Jumps^                 ^Jumps^
    -------------------------------------------------------
    _h_: Home            _m_: Musk           _f_: .dotfiles
    _l_: Desk            _p_: Pix            _c_: .config
    _w_: DLs             _v_: Vidz           _s_: .scripts
    _d_: Docs            _t_: tmp            _i_:  Media
    _r_: git-docs        _T_: Trash          _q_:  Quit/Cancel
    "
    ;; _p_: Projects
    ("h" (dired "~/"))
    ("l" (dired "~/Desk/"))
    ("w" (dired "~/DLs/"))
    ("d" (dired "~/Docs/"))
    ("r" (dired "~/Docs/11.git_docs/"))
    ("m" (dired "~/Musk/"))
    ("p" (dired "~/Pix/"))
    ("v" (dired "~/Vidz/"))
    ("t" (dired "~/tmp/"))
    ("T" (dired "~/.local/share/Trash/files/"))
    ("f" (dired "~/.dotfiles/"))
    ("c" (dired "~/.config/"))
    ("s" (dired "~/.scripts/"))
    ("i" (dired "/run/media/"))
    ("q" nil)  ; One single exit point
    ("g" nil)) ; Optional: 'g' again to close it if you hit it by accident
  ;; ("p" (if (fboundp 'project-find-dir) (call-interactively 'project-find-dir) (dired "~/Projects/")))


  ;; 2. The Dired Configuration
  (use-package dired
    :ensure nil
    :bind (:map dired-mode-map
                ;; Ranger/Yazi style navigation
                ("i" . dired-previous-line)
                ("k" . dired-next-line)
                ("j" . dired-up-directory)
                ("l" . dired-find-file)
                ("/" . dired-goto-file)
                ;; The "g" Jump Menu
                ("g" . hydra-dired-jump/body)
                ;; Rebind original 'g' (refresh) to 'r'
                ("r" . revert-buffer))
    :config
    ;; NO CLUTTER: Don't create a new buffer for every folder
    (setq dired-kill-when-opening-new-dired-buffers t)

    ;; SORTING: Dots first, then Directories, then Files
    (setq ls-lisp-use-insert-directory-program nil)
    (require 'ls-lisp)
    (setq ls-lisp-dirs-first t)
    (setq ls-lisp-ignore-case t)
    ;; Note: --group-directories-first is handled by ls-lisp-dirs-first t
    (setq dired-listing-switches "-AGFhlv --time-style=long-iso")

    ;; HIDE DETAILS: Start Dired with just filenames (press '(' to toggle)
    (add-hook 'dired-mode-hook 'dired-hide-details-mode))

  ;; 3. Open Files Externally
  (use-package dired-open
    :ensure t
    :config
    (setq dired-open-extensions '(("png"  . "nsxiv")
                                  ("jpg"  . "nsxiv")
                                  ("jpeg" . "nsxiv")
                                  ("gif"  . "nsxiv")
                                  ("bmp"  . "nsxiv")
                                  ("mkv"  . "mpv")
                                  ("avi"  . "mpv")
                                  ("mp4"  . "mpv")
                                  ("mp3"  . "mpv")
                                  ("pdf"  . "zathura"))))

